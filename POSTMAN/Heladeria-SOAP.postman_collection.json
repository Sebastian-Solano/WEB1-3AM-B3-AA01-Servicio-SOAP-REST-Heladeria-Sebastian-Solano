{
  "info": {
    "name": "Heladería SOAPA · SOAP",
    "description": "Colección SOAP 1.1 de Categoría y Producto.\n\nURL: http://localhost:5102/ProductoService.asmx\nWSDL: http://localhost:5102/ProductoService.asmx?wsdl\n\nContent-Type: text/xml; charset=utf-8\nLos miembros DataContract van en orden alfabético.\nAjuste categoriaId y productoId en las variables de la colección.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "soapUrl", "value": "http://localhost:5102/ProductoService.asmx" },
    { "key": "categoriaId", "value": "1" },
    { "key": "productoId", "value": "1" }
  ],
  "item": [
    {
      "name": "ObtenerCategorias",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "text/xml; charset=utf-8" },
          { "key": "SOAPAction", "value": "\"http://tempuri.org/IProductoService/ObtenerCategorias\"" }
        ],
        "body": {
          "mode": "raw",
          "raw": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\">\n  <soap:Body>\n    <ObtenerCategorias xmlns=\"http://tempuri.org/\"></ObtenerCategorias>\n  </soap:Body>\n</soap:Envelope>",
          "options": { "raw": { "language": "xml" } }
        },
        "url": "{{soapUrl}}"
      }
    },
    {
      "name": "ObtenerProductos",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "text/xml; charset=utf-8" },
          { "key": "SOAPAction", "value": "\"http://tempuri.org/IProductoService/ObtenerProductos\"" }
        ],
        "body": {
          "mode": "raw",
          "raw": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\">\n  <soap:Body>\n    <ObtenerProductos xmlns=\"http://tempuri.org/\"></ObtenerProductos>\n  </soap:Body>\n</soap:Envelope>",
          "options": { "raw": { "language": "xml" } }
        },
        "url": "{{soapUrl}}"
      }
    },
    {
      "name": "ObtenerProducto",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "text/xml; charset=utf-8" },
          { "key": "SOAPAction", "value": "\"http://tempuri.org/IProductoService/ObtenerProducto\"" }
        ],
        "body": {
          "mode": "raw",
          "raw": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\">\n  <soap:Body>\n    <ObtenerProducto xmlns=\"http://tempuri.org/\">\n      <id>{{productoId}}</id>\n    </ObtenerProducto>\n  </soap:Body>\n</soap:Envelope>",
          "options": { "raw": { "language": "xml" } }
        },
        "url": "{{soapUrl}}"
      }
    },
    {
      "name": "AgregarProducto",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const m = pm.response.text().match(/<(?:[\\w]+:)?IdProducto>(\\d+)<\\//);",
              "if (m) pm.collectionVariables.set(\"productoId\", m[1]);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "text/xml; charset=utf-8" },
          { "key": "SOAPAction", "value": "\"http://tempuri.org/IProductoService/AgregarProducto\"" }
        ],
        "body": {
          "mode": "raw",
          "raw": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\">\n  <soap:Body>\n    <AgregarProducto xmlns=\"http://tempuri.org/\">\n      <producto xmlns:d=\"http://schemas.datacontract.org/2004/07/HeladeriaSOAPA.Models\">\n        <d:Descripcion>Helado de prueba Postman</d:Descripcion>\n        <d:Estado>true</d:Estado>\n        <d:IdCategoria>{{categoriaId}}</d:IdCategoria>\n        <d:IdProducto>0</d:IdProducto>\n        <d:Nombre>Vainilla Postman</d:Nombre>\n        <d:Precio>2.50</d:Precio>\n        <d:Stock>10</d:Stock>\n      </producto>\n    </AgregarProducto>\n  </soap:Body>\n</soap:Envelope>",
          "options": { "raw": { "language": "xml" } }
        },
        "url": "{{soapUrl}}"
      }
    },
    {
      "name": "ActualizarProducto",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "text/xml; charset=utf-8" },
          { "key": "SOAPAction", "value": "\"http://tempuri.org/IProductoService/ActualizarProducto\"" }
        ],
        "body": {
          "mode": "raw",
          "raw": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\">\n  <soap:Body>\n    <ActualizarProducto xmlns=\"http://tempuri.org/\">\n      <producto xmlns:d=\"http://schemas.datacontract.org/2004/07/HeladeriaSOAPA.Models\">\n        <d:Descripcion>Helado actualizado desde Postman</d:Descripcion>\n        <d:Estado>true</d:Estado>\n        <d:IdCategoria>{{categoriaId}}</d:IdCategoria>\n        <d:IdProducto>{{productoId}}</d:IdProducto>\n        <d:Nombre>Vainilla Postman</d:Nombre>\n        <d:Precio>3.25</d:Precio>\n        <d:Stock>10</d:Stock>\n      </producto>\n    </ActualizarProducto>\n  </soap:Body>\n</soap:Envelope>",
          "options": { "raw": { "language": "xml" } }
        },
        "url": "{{soapUrl}}"
      }
    },
    {
      "name": "EliminarProducto",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "text/xml; charset=utf-8" },
          { "key": "SOAPAction", "value": "\"http://tempuri.org/IProductoService/EliminarProducto\"" }
        ],
        "body": {
          "mode": "raw",
          "raw": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\">\n  <soap:Body>\n    <EliminarProducto xmlns=\"http://tempuri.org/\">\n      <id>{{productoId}}</id>\n    </EliminarProducto>\n  </soap:Body>\n</soap:Envelope>",
          "options": { "raw": { "language": "xml" } }
        },
        "url": "{{soapUrl}}"
      }
    },
    {
      "name": "ObtenerProductosPorPrecio",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "text/xml; charset=utf-8" },
          { "key": "SOAPAction", "value": "\"http://tempuri.org/IProductoService/ObtenerProductosPorPrecio\"" }
        ],
        "body": {
          "mode": "raw",
          "raw": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\">\n  <soap:Body>\n    <ObtenerProductosPorPrecio xmlns=\"http://tempuri.org/\">\n      <precioMinimo>1</precioMinimo>\n      <precioMaximo>10</precioMaximo>\n    </ObtenerProductosPorPrecio>\n  </soap:Body>\n</soap:Envelope>",
          "options": { "raw": { "language": "xml" } }
        },
        "url": "{{soapUrl}}"
      }
    },
    {
      "name": "ObtenerProductosPorCategoria",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "text/xml; charset=utf-8" },
          { "key": "SOAPAction", "value": "\"http://tempuri.org/IProductoService/ObtenerProductosPorCategoria\"" }
        ],
        "body": {
          "mode": "raw",
          "raw": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\">\n  <soap:Body>\n    <ObtenerProductosPorCategoria xmlns=\"http://tempuri.org/\">\n      <idCategoria>{{categoriaId}}</idCategoria>\n    </ObtenerProductosPorCategoria>\n  </soap:Body>\n</soap:Envelope>",
          "options": { "raw": { "language": "xml" } }
        },
        "url": "{{soapUrl}}"
      }
    },
    {
      "name": "AgregarCategoria",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const m = pm.response.text().match(/<(?:[\\w]+:)?IdCategoria>(\\d+)<\\//);",
              "if (m) pm.collectionVariables.set(\"categoriaId\", m[1]);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "text/xml; charset=utf-8" },
          { "key": "SOAPAction", "value": "\"http://tempuri.org/IProductoService/AgregarCategoria\"" }
        ],
        "body": {
          "mode": "raw",
          "raw": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\">\n  <soap:Body>\n    <AgregarCategoria xmlns=\"http://tempuri.org/\">\n      <categoria xmlns:d=\"http://schemas.datacontract.org/2004/07/HeladeriaSOAPA.Models\">\n        <d:Descripcion>Categoría de prueba Postman</d:Descripcion>\n        <d:Estado>true</d:Estado>\n        <d:IdCategoria>0</d:IdCategoria>\n        <d:Nombre>Helados Postman</d:Nombre>\n      </categoria>\n    </AgregarCategoria>\n  </soap:Body>\n</soap:Envelope>",
          "options": { "raw": { "language": "xml" } }
        },
        "url": "{{soapUrl}}"
      }
    },
    {
      "name": "ActualizarCategoria",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "text/xml; charset=utf-8" },
          { "key": "SOAPAction", "value": "\"http://tempuri.org/IProductoService/ActualizarCategoria\"" }
        ],
        "body": {
          "mode": "raw",
          "raw": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\">\n  <soap:Body>\n    <ActualizarCategoria xmlns=\"http://tempuri.org/\">\n      <categoria xmlns:d=\"http://schemas.datacontract.org/2004/07/HeladeriaSOAPA.Models\">\n        <d:Descripcion>Categoría actualizada desde Postman</d:Descripcion>\n        <d:Estado>true</d:Estado>\n        <d:IdCategoria>{{categoriaId}}</d:IdCategoria>\n        <d:Nombre>Helados Postman</d:Nombre>\n      </categoria>\n    </ActualizarCategoria>\n  </soap:Body>\n</soap:Envelope>",
          "options": { "raw": { "language": "xml" } }
        },
        "url": "{{soapUrl}}"
      }
    },
    {
      "name": "EliminarCategoria",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "text/xml; charset=utf-8" },
          { "key": "SOAPAction", "value": "\"http://tempuri.org/IProductoService/EliminarCategoria\"" }
        ],
        "body": {
          "mode": "raw",
          "raw": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\">\n  <soap:Body>\n    <EliminarCategoria xmlns=\"http://tempuri.org/\">\n      <id>{{categoriaId}}</id>\n    </EliminarCategoria>\n  </soap:Body>\n</soap:Envelope>",
          "options": { "raw": { "language": "xml" } }
        },
        "url": "{{soapUrl}}"
      }
    }
  ]
}
